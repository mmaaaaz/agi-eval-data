{
  "name": "agi-eval-data",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:web": "turbo run dev --filter=@agi-eval/web",
    "dev:relay": "turbo run dev --filter=@agi-eval/relay",
    "deploy:web": "bun run build --filter=@agi-eval/web && npx wrangler pages deploy apps/web/dist --project-name agi-eval-data --branch main --commit-dirty=true",
    "deploy:relay": "cd apps/relay && npx wrangler deploy"
  },
  "devDependencies": {
    "turbo": "^2.10.11"
  }
}